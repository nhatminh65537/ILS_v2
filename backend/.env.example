# ILS v2 — Environment Variables Template
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.

# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Comment out to use SQLite (default dev mode)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ils_dev
DB_USER=ils_user
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# ── JWT Token Lifetimes (minutes) ────────────────────────────────────────────
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend URL (for password-reset links) ──────────────────────────────────
# Public base URL of the Next.js app. Reset emails link to
# {FRONTEND_URL}/{locale}/reset-password?token=... (locale defaults to "vi").
FRONTEND_URL=http://localhost:4000
# FRONTEND_DEFAULT_LOCALE=vi

# ── Email / SMTP (password reset) ────────────────────────────────────────────
# BOOTSTRAP ONLY. These values are read by `python manage.py seed_config`, which
# copies them into the `auth.email.*` rows of system_config IF those rows are
# still empty (it never overwrites a value an admin edited via the UI). At
# RUNTIME, EmailService reads SMTP settings exclusively from system_config — the
# env vars below are NOT consulted while serving requests.
#
# So: set these, run `seed_config` once, and thereafter manage SMTP centrally in
# the admin config UI. If SMTP is left unconfigured, password-reset requests
# still return 200 (anti-enumeration) but no email is sent (a warning is logged).
# For Gmail, use an App Password (not your account password).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_SENDER_ADDRESS=

# ── Redis (for Django Channels in production) ────────────────────────────────
# Leave empty to use InMemoryChannelLayer (dev only)
REDIS_URL=redis://localhost:6379/0

# ── Outline integration (seeded into system_config by `seed_config`) ─────────
# When both URL and token are set here, `python manage.py seed_config` auto-fills
# the `outline.url` / `outline.api_token` config rows and enables `outline.enabled`.
# Leaving them empty keeps Outline disabled (configurable later via the admin UI).
OUTLINE_URL=
OUTLINE_API_TOKEN=

# ── GitLab challenge sync (Task 6.8; seeded into system_config by `seed_config`)
# When both URL and token are set here, `python manage.py seed_config` auto-fills
# the `challenge.git.url` / `challenge.git.token` rows and enables
# `challenge.git.enabled`. Use a read-only Group Access Token (scopes read_api +
# read_repository). Leaving them empty keeps GitLab sync disabled.
GITLAB_URL=
GITLAB_TOKEN=

# ── Deploy server address (Task 6.9; seeded into system_config by `seed_config`) ─
# host:port of the challenge deploy-server. When set, `seed_config` bootstraps the
# `challenge.deploy.api_url` row so the backend auto-connects (provider='socket').
# In Docker compose this is set to `deployer:9100` (the in-network deployer service).
# Leave empty to configure the address later via the admin UI. Bootstrap-only — a
# re-seed never clobbers an admin-edited value.
DEPLOY_API_URL=

# ── System Config Secrets (seeded via seed_config command) ───────────────────
# These are managed via the admin UI / system_config table at runtime.
# Listed here for reference only.
#
# auth.sso_client_secret     → Authentik OAuth2 client secret
# auth.email.password        → SMTP password
# outline.api_token          → Outline API token (set via OUTLINE_API_TOKEN above)
# challenge.git.token        → GitLab PAT token
# challenge.deploy.api_token → Deploy server token
# ai.api_key                 → LLM provider API key
