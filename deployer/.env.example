# Copy to .env and fill in. The deployer loads .env on startup (config.py).

# ── Registry auth (to docker-login + pull challenge images) ──────────────────
# A GitLab access token (or deploy token) with the read_registry scope.
DEPLOY_REGISTRY=registry.gitlab.example.org
DEPLOY_REGISTRY_USER=deploy-bot
DEPLOY_REGISTRY_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# ── Network (SECURITY: keep this private — there is NO auth on the socket) ────
DEPLOY_BIND_ADDR=127.0.0.1        # interface to listen on
DEPLOY_LISTEN_PORT=9100           # TCP port ILS connects to (challenge.deploy.api_url)
DEPLOY_PUBLIC_HOST=localhost      # host advertised back to users for container access

# ── Container constraints ────────────────────────────────────────────────────
DEPLOY_MEM_LIMIT=256m
DEPLOY_NETWORK=ils-challenges
DEPLOY_DEFAULT_EXPOSED_PORT=5000  # fallback if an image declares no EXPOSE
DEPLOY_REAPER_INTERVAL=60         # seconds between TTL reaper sweeps
