# ILS v2 — Docker Compose environment (repo root).
#
# Copy to `.env` (next to docker-compose.yml) and adjust. Compose interpolates these
# into the `db` and `backend` services. They are SEPARATE from:
#   - backend/.env   (Django + integration secrets: Outline / GitLab / SMTP)
#   - deployer/.env  (registry auth for the deploy server)
#
# All values have safe local defaults in docker-compose.yml, so an empty .env still
# brings the stack up — override here for anything non-default.

# ── PostgreSQL (db service; also consumed by the backend DB_* wiring) ─────────
POSTGRES_DB=ils
POSTGRES_USER=ils
POSTGRES_PASSWORD=ils_dev_password

# ── First admin bootstrap (seed_admin runs on first backend boot, idempotent) ──
# CHANGE THESE before any non-local use. Password also overridable per seed_admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@example.com
